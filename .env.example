# Copy to .env (git-ignored) and fill in ONLY what your adapter needs.
# Edit this file yourself on your own machine. Never paste these values into a chat, an issue or a commit.

# adapter "ical": the private calendar/subscription link from your school platform
ICAL_URL=

# your own adapter (copied from adapters/_template.py): login for the school platform
SCHOOL_USERNAME=
SCHOOL_PASSWORD=
